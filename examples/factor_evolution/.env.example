# ===== 必填 =====
# Tushare 数据 Token（注册地址: https://tushare.pro）
TUSHARE_TOKEN=your_tushare_token_here

# LLM API Key（DeepSeek / OpenAI 兼容接口）
LLM_API_KEY=sk-your_api_key_here
LLM_API_BASE=https://api.deepseek.com/v1

# ===== 可选：OpenAI 兼容 Embedding API（知识库向量检索 fallback）=====
# 仅在本地 embedding server 不可用时使用
# OPENAI_API_KEY=sk-your_openai_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1

# ===== 可选：本地 Embedding Server（知识库向量检索，优先使用）=====
# EMBEDDING_LOCAL_URL=http://localhost:8190/llm_service/embedding
